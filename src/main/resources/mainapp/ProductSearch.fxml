<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Requests.ProductSearch" style="-fx-background-color: #f4f4f4;">
    <!-- Верхняя панель: Поиск -->
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-radius: 10px;">
            <Label text="Поиск товара:" style="-fx-font-size: 16px; -fx-text-fill: #333;"/>
            <ComboBox fx:id="comboBoxSearchType" promptText="Выберите параметр" style="-fx-font-size: 14px; -fx-background-color: #f4f4f4;"/>
            <TextField fx:id="textfieldEnterSearch" promptText="Введите текст для поиска" style="-fx-font-size: 14px; -fx-background-color: #f4f4f4;"/>
            <Button text="Найти" onAction="#loadProducts" style="-fx-background-color: linear-gradient(#6422ff, #3b17b5); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);"/>
            <Button text="Назад" fx:id="logoutButton" onAction="#Back_Pressed" style="-fx-background-color: linear-gradient(#7dc1f8, #2196F3); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);"/>
        </HBox>
    </top>

    <!-- Центральная область: Список товаров -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: white;">
            <TilePane fx:id="productTilePane" hgap="15" vgap="15" alignment="TOP_LEFT"
                      style="-fx-padding: 15; -fx-background-color: #ffffff;">
                <!-- Карточки товаров добавляются программно -->
            </TilePane>
        </ScrollPane>
    </center>
</BorderPane>
