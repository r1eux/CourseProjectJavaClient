<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="577.0" prefWidth="790.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Requests.CartAdd">

    <!-- Поле для поиска -->


    <!-- Кнопка выхода -->
    <Button fx:id="logoutButton" layoutX="536.0" layoutY="536.0" onAction="#Back_Pressed" prefWidth="100" text="Выход" />

    <!-- Текстовые метки для сообщений -->
    <Label fx:id="labelMessage" layoutX="30" layoutY="80" textFill="red" visible="false" />
    <Label fx:id="labelMessageTrue" layoutX="30" layoutY="100" textFill="green" visible="false" />

    <!-- Сетка с товарами -->
    <TilePane fx:id="productTilePane" hgap="15" layoutX="30" layoutY="130" prefColumns="3" prefWidth="700" vgap="15" />

    <!-- Отзывы -->
    <VBox fx:id="reviewTilePane" layoutX="24.0" layoutY="455.0" spacing="15">
        <Button fx:id="checkReviewButton" disable="true" onAction="#handleLoadReviews" prefWidth="200" text="Показать все отзывы" />
        <TextField fx:id="textfieldReview" prefWidth="300" promptText="Ваш отзыв" />
        <Button fx:id="addReviewButton" disable="true" onAction="#AddReview" prefWidth="200" text="Добавить отзыв" />
    </VBox>

    <!-- Добавить в корзину -->
    <HBox layoutX="350.0" layoutY="455.0" spacing="15">
        <TextField fx:id="quantityTextField" prefWidth="120" promptText="Количество" />
        <Button fx:id="addToCartButton" onAction="#addToCart" prefWidth="150" text="Добавить в корзину" />
    </HBox>

</AnchorPane>
