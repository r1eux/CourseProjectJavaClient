<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="Requests.UserSearch" style="-fx-background-color: #f4f4f4;">
   <children>
      <!-- Поле для поиска -->
      <VBox layoutX="20.0" layoutY="20.0" spacing="10.0">
         <children>
            <ComboBox fx:id="comboBoxSearchType" prefWidth="200.0" style="-fx-background-color: #ffffff; -fx-border-color: #ddd; -fx-padding: 5px;" />
            <TextField fx:id="textfieldEnterSearch" prefWidth="200.0" promptText="Введите запрос"
                       style="-fx-background-color: #ffffff; -fx-border-color: #ddd; -fx-padding: 5px;" />
         </children>
      </VBox>

      <!-- Контейнер для отображения пользователей -->
      <TilePane fx:id="userTilePane" hgap="10.0" layoutX="20.0" layoutY="100.0" prefHeight="400.0" prefWidth="760.0"
                style="-fx-background-color: #ffffff; -fx-border-color: #ddd; -fx-padding: 10px;" vgap="10.0">
      </TilePane>

      <!-- Кнопка выхода -->
      <Button fx:id="logoutButton" layoutX="20.0" layoutY="520.0" onAction="#Back_Pressed" prefWidth="80.0"
              text="Назад" style="-fx-background-color: #2243ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px;" />

      <!-- Кнопка поиска -->
      <Button layoutX="253.0" layoutY="19.0" onAction="#loadUsers" prefWidth="100.0" text="Поиск"
              style="-fx-background-color: #8e4caf; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px;" />
   </children>
</AnchorPane>
