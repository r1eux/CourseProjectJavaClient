<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="Requests.UserOrderCheck" style="-fx-background-color: #f4f4f4;">
    <children>
        <!-- Кнопка Назад -->
        <Button fx:id="logoutButton" layoutX="267.0" layoutY="620.0" mnemonicParsing="false" onAction="#Back_Pressed"
                text="Назад" style="-fx-background-color: #FF5722; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 10px;" />

        <!-- Область для заказов -->
        <ScrollPane fitToWidth="true" layoutX="10.0" layoutY="10.0" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #ffffff; -fx-border-color: #ddd;">
            <content>
                <TilePane fx:id="orderTilePane" prefColumns="3" hgap="10" vgap="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10" />
                    </padding>
                </TilePane>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
