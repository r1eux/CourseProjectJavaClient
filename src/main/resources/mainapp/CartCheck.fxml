<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="Requests.CartCheck">
    <children>
        <!-- TilePane for displaying products -->
        <TilePane fx:id="productTilePane" hgap="10" layoutX="20" layoutY="20" prefColumns="4" prefRows="4" vgap="10" />

        <!-- Buttons for cart and order operations -->

        <Button fx:id="addToOrderButton" layoutX="152.0" layoutY="450.0" onAction="#addToOrder" text="Добавить в заказ" />
        <Button fx:id="placeOrderButton" disable="true" layoutX="20" layoutY="450" onAction="#placeOrder" text="Оформить заказ" />

        <!-- Label to show success/error messages -->
        <Label fx:id="labelMessageTrue" layoutX="20" layoutY="500" textFill="green" visible="false" />
        <Label fx:id="labelMessage" layoutX="20" layoutY="550" textFill="red" visible="false" />

        <!-- Input for quantity -->

        <!-- Logout Button -->
        <Button fx:id="logoutButton" layoutX="20.0" layoutY="537.0" onAction="#backPressed" text="Выйти" />

        <!-- Placeholder for product details (Image, Name, Price, etc.) -->
        <VBox fx:id="productDetails" layoutX="250" layoutY="20" spacing="10">
            <ImageView fx:id="productImageView" fitHeight="100" fitWidth="100" />
            <Label fx:id="productName" />
            <Label fx:id="productPrice" />
            <Label fx:id="productColor" />
            <Label fx:id="productProducer" />
            <Label fx:id="productAmount" />
            <Label fx:id="productCategory" />
            <Label fx:id="productProducerCountry" />
            <Label fx:id="productWarranty" />
        </VBox>
    </children>
</AnchorPane>
