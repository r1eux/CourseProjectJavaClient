<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="445.0" prefWidth="419.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Requests.UserAdd">
   <children>
      <!-- Пароль -->
      <PasswordField fx:id="passwordfieldPassword" layoutX="30.0" layoutY="124.0" style="-fx-background-color: #f4f4f4; -fx-font-size: 14px; -fx-border-color: #ddd;" />
      <PasswordField fx:id="passwordfieldConfirmPassword" layoutX="30.0" layoutY="176.0" style="-fx-background-color: #f4f4f4; -fx-font-size: 14px; -fx-border-color: #ddd;" />

      <!-- Лейблы -->
      <Label layoutX="33.0" layoutY="107.0" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Пароль:" />
      <Label layoutX="30.0" layoutY="159.0" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Подтверждение пароля:" />
      <Label layoutX="36.0" layoutY="53.0" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Логин:" />
      <Label layoutX="217.0" layoutY="53.0" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Номер телефона:" />
      <Label layoutX="219.0" layoutY="107.0" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Пол:" />
      <Label layoutX="30.0" layoutY="216.0" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Имя:" />
      <Label layoutX="30.0" layoutY="274.0" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Страна:" />
      <Label layoutX="30.0" layoutY="336.0" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Город:" />
      <Label layoutX="222.0" layoutY="159.0" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Улица:" />
      <Label layoutX="219.0" layoutY="216.0" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Дом:" />
      <Label layoutX="215.0" layoutY="274.0" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Почтовый индекс:" />
      <Label layoutX="219.0" layoutY="336.0" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Электронная почта:" />

      <!-- Текстовые поля -->
      <TextField fx:id="textfieldLogin" layoutX="30.0" layoutY="70.0" style="-fx-background-color: #f4f4f4; -fx-font-size: 14px; -fx-border-color: #ddd;" />
      <TextField fx:id="textfieldPhone" layoutX="217.0" layoutY="70.0" style="-fx-background-color: #f4f4f4; -fx-font-size: 14px; -fx-border-color: #ddd;" />
      <TextField fx:id="textfieldName" layoutX="30.0" layoutY="234.0" style="-fx-background-color: #f4f4f4; -fx-font-size: 14px; -fx-border-color: #ddd;" />
      <TextField fx:id="textfieldCountry" layoutX="30.0" layoutY="292.0" style="-fx-background-color: #f4f4f4; -fx-font-size: 14px; -fx-border-color: #ddd;" />
      <TextField fx:id="textfieldCity" layoutX="30.0" layoutY="354.0" style="-fx-background-color: #f4f4f4; -fx-font-size: 14px; -fx-border-color: #ddd;" />
      <TextField fx:id="textfieldStreet" layoutX="217.0" layoutY="176.0" style="-fx-background-color: #f4f4f4; -fx-font-size: 14px; -fx-border-color: #ddd;" />
      <TextField fx:id="textfieldHouseNumber" layoutX="217.0" layoutY="234.0" style="-fx-background-color: #f4f4f4; -fx-font-size: 14px; -fx-border-color: #ddd;" />
      <TextField fx:id="textfieldPostIndex" layoutX="217.0" layoutY="292.0" style="-fx-background-color: #f4f4f4; -fx-font-size: 14px; -fx-border-color: #ddd;" />
      <TextField fx:id="textfieldEmail" layoutX="216.0" layoutY="354.0" style="-fx-background-color: #f4f4f4; -fx-font-size: 14px; -fx-border-color: #ddd;" />

      <!-- Радио кнопки -->
      <RadioButton fx:id="cbMale" layoutX="216.0" layoutY="128.0" mnemonicParsing="false" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="M">
         <toggleGroup>
            <ToggleGroup fx:id="Sex" />
         </toggleGroup></RadioButton>
      <RadioButton fx:id="cbFemale" layoutX="265.0" layoutY="128.0" mnemonicParsing="false" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Ж" toggleGroup="$Sex" />

      <!-- Кнопки -->
      <Button fx:id="buttonSignUp" layoutX="29.0" layoutY="395.0" mnemonicParsing="false" onAction="#Signup_Pressed" prefHeight="41.0" prefWidth="186.0" style="-fx-background-color: linear-gradient(#6422ff, #3b17b5); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);" text="Добавить пользователя" />
      <Button fx:id="buttonBack" layoutX="267.0" layoutY="396.0" mnemonicParsing="false" onAction="#Back_Pressed" style="-fx-background-color: linear-gradient(#7dc1f8, #2196F3); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);" text="Назад" />

      <!-- Сообщение об ошибке -->
      <Label fx:id="labelMessage" alignment="CENTER" contentDisplay="CENTER" layoutX="221.0" layoutY="357.0" prefHeight="18.0" prefWidth="90.0" style="-fx-font-size: 14px;" text="error" textFill="RED" visible="false" />
   </children>
</AnchorPane>
