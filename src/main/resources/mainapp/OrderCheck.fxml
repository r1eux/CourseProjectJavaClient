<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Requests.OrderCheck" style="-fx-background-color: #f4f4f4;">
    <!-- Верхняя часть окна -->
    <top>
        <ToolBar>
            <Button fx:id="logoutButton" text="Выход" onAction="#Back_Pressed" style="-fx-background-color: linear-gradient(#6422ff, #3b17b5); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);" />
        </ToolBar>
    </top>

    <!-- Центральная часть окна -->
    <center>
        <ScrollPane>
            <TilePane fx:id="orderTilePane" prefColumns="2" hgap="10" vgap="10" >
                <!-- Динамически добавляемые элементы VBox будут здесь -->
            </TilePane>
        </ScrollPane>
    </center>

    <!-- Нижняя часть окна -->
    <bottom>
        <VBox spacing="10" >
            <!-- Сообщения об ошибках или успехе -->
            <Label fx:id="labelMessage" textFill="red" visible="false" />
            <Label fx:id="labelMessageTrue" textFill="green" visible="false" />

            <!-- Панель для изменения статуса -->
            <HBox spacing="10" alignment="CENTER">
                <Label text="Выберите новый статус:" />
                <ComboBox fx:id="statusComboBox" prefWidth="200" style="-fx-background-color: linear-gradient(#9b75ca, #6a41a6); -fx-font-size: 14px; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15px; -fx-padding: 8px 10px;" />
                <Button text="Изменить статус" onAction="#changeStatus" style="-fx-background-color: linear-gradient(#6422ff, #3b17b5); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
