<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Requests.ProductDelete" style="-fx-background-color: #f4f4f4;">
    <children>
        <!-- Заголовок -->
        <Label text="Удаление товара" layoutX="20.0" layoutY="10.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" />

        <!-- Контейнер для товаров -->
        <ScrollPane layoutX="20.0" layoutY="50.0" prefWidth="560.0" prefHeight="350.0">
            <content>
                <TilePane fx:id="productTilePane" prefColumns="2" hgap="10.0" vgap="10.0" style="-fx-padding: 10;">
                </TilePane>
            </content>
        </ScrollPane>

        <!-- Кнопка удаления -->
        <Button fx:id="deleteButton" text="Удалить товар" layoutX="20.0" layoutY="420.0" prefWidth="150.0"
                disable="true" onAction="#deleteProduct"
                style="-fx-background-color: linear-gradient(#9b75ca, #6a41a6); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);" />

        <!-- Кнопка возврата -->
        <Button fx:id="logoutButton" text="Назад" layoutX="200.0" layoutY="420.0" prefWidth="100.0" onAction="#backPressed"
                style="-fx-background-color: linear-gradient(#7dc1f8, #2196F3); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);" />

        <!-- Информационное сообщение -->
    </children>
</AnchorPane>
