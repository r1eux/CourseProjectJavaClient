<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="Requests.UserDelete" style="-fx-background-color: #f4f4f4;">
    <children>
        <!-- Верхняя панель управления -->
        <VBox spacing="10" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <HBox spacing="10">
                <Label text="Удаление пользователей" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="logoutButton" text="Назад" onAction="#Back_Pressed" style="-fx-background-color: linear-gradient(#7dc1f8, #2196F3); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 10px;" />
            </HBox>
            <HBox spacing="10">
                <Label fx:id="labelMessage" textFill="red" visible="false" style="-fx-font-size: 14px;" />
                <Label fx:id="labelMessageTrue" textFill="green" visible="false" style="-fx-font-size: 14px;" />
            </HBox>
        </VBox>

        <!-- Область отображения пользователей -->
        <ScrollPane AnchorPane.topAnchor="70.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" style="-fx-background-color: white;">
            <content>
                <TilePane fx:id="userTilePane" prefColumns="3" hgap="15" vgap="15" style="-fx-padding: 10;"/>
            </content>
        </ScrollPane>

        <!-- Нижняя панель с кнопками -->
        <HBox spacing="10" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="delete" text="Удалить выбранного пользователя" onAction="#DeleteUser" disable="true" style="-fx-background-color: linear-gradient(#6422ff, #3b17b5); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);" />
        </HBox>
    </children>
</AnchorPane>
