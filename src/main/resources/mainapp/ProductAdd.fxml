<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="517.0" prefWidth="600.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Requests.ProductAdd">
   <children>
      <!-- Заголовок -->
      <Label layoutX="200.0" layoutY="20.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Добавление товара" />

      <!-- Поля ввода -->
      <VBox alignment="CENTER_LEFT" layoutX="150.0" layoutY="60.0" spacing="10.0">
         <children>
            <HBox spacing="10.0">
               <Label style="-fx-font-size: 14px; -fx-text-fill: #555;" text="Название товара:" />
               <TextField fx:id="textfieldName" prefHeight="33.0" prefWidth="299.0" style="-fx-background-color: #ffffff; -fx-font-size: 14px; -fx-background-radius: 10px; -fx-padding: 5px; -fx-border-color: #ddd;" />
            </HBox>
            <HBox spacing="10.0">
               <Label style="-fx-font-size: 14px; -fx-text-fill: #555;" text="Цена:" />
               <TextField fx:id="textfieldPrice" prefHeight="33.0" prefWidth="376.0" style="-fx-background-color: #ffffff; -fx-font-size: 14px; -fx-background-radius: 10px; -fx-padding: 5px; -fx-border-color: #ddd;" />
            </HBox>
            <HBox spacing="10.0">
               <Label style="-fx-font-size: 14px; -fx-text-fill: #555;" text="Ссылка на изображение:" />
               <TextField fx:id="textfieldURL" prefWidth="250.0" style="-fx-background-color: #ffffff; -fx-font-size: 14px; -fx-background-radius: 10px; -fx-padding: 5px; -fx-border-color: #ddd;" />
            </HBox>
            <HBox spacing="10.0">
               <Label style="-fx-font-size: 14px; -fx-text-fill: #555;" text="Цвет:" />
               <TextField fx:id="textfieldColor" prefHeight="13.0" prefWidth="375.0" style="-fx-background-color: #ffffff; -fx-font-size: 14px; -fx-background-radius: 10px; -fx-padding: 5px; -fx-border-color: #ddd;" />
            </HBox>
            <HBox spacing="10.0">
               <Label style="-fx-font-size: 14px; -fx-text-fill: #555;" text="Производитель:" />
               <TextField fx:id="textfieldProducer" prefHeight="34.0" prefWidth="305.0" style="-fx-background-color: #ffffff; -fx-font-size: 14px; -fx-background-radius: 10px; -fx-padding: 5px; -fx-border-color: #ddd;" />
            </HBox>
            <HBox spacing="10.0">
               <Label style="-fx-font-size: 14px; -fx-text-fill: #555;" text="Количество:" />
               <TextField fx:id="textfieldAmount" prefHeight="33.0" prefWidth="330.0" style="-fx-background-color: #ffffff; -fx-font-size: 14px; -fx-background-radius: 10px; -fx-padding: 5px; -fx-border-color: #ddd;" />
            </HBox>
            <HBox spacing="10.0">
               <Label style="-fx-font-size: 14px; -fx-text-fill: #555;" text="Гарантия:" />
               <TextField fx:id="textfieldWarranty" prefHeight="33.0" prefWidth="346.0" style="-fx-background-color: #ffffff; -fx-font-size: 14px; -fx-background-radius: 10px; -fx-padding: 5px; -fx-border-color: #ddd;" />
            </HBox>
            <HBox spacing="10.0">
               <Label style="-fx-font-size: 14px; -fx-text-fill: #555;" text="Категория:" />
               <TextField fx:id="textfieldCategory" prefHeight="33.0" prefWidth="338.0" style="-fx-background-color: #ffffff; -fx-font-size: 14px; -fx-background-radius: 10px; -fx-padding: 5px; -fx-border-color: #ddd;" />
            </HBox>
            <HBox spacing="10.0">
               <Label style="-fx-font-size: 14px; -fx-text-fill: #555;" text="Страна-производитель:" />
               <TextField fx:id="textfieldProducerCountry" prefHeight="33.0" prefWidth="257.0" style="-fx-background-color: #ffffff; -fx-font-size: 14px; -fx-background-radius: 10px; -fx-padding: 5px; -fx-border-color: #ddd;" />
            </HBox>
         </children>
      </VBox>

      <!-- Кнопки -->
      <HBox alignment="CENTER" layoutX="200.0" layoutY="400.0" spacing="20.0" />

      <!-- Сообщения об ошибке/успехе -->
      <Label fx:id="labelMessageTrue" layoutX="250.0" layoutY="470.0" style="-fx-text-fill: #4CAF50; -fx-font-size: 14px;" text="Успех!" visible="false" />
      <Label fx:id="labelMessage" layoutX="250.0" layoutY="470.0" style="-fx-text-fill: #F44336; -fx-font-size: 14px;" text="Ошибка" visible="false" />
      <Button fx:id="buttonAddProduct" layoutX="184.0" layoutY="460.0" onAction="#ProductAdd" style="-fx-background-color: linear-gradient(#6422ff, #3b17b5); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);" text="Добавить товар" />
      <Button fx:id="buttonBack" layoutX="323.0" layoutY="460.0" onAction="#Back_Pressed" style="-fx-background-color: linear-gradient(#6422ff, #3b17b5); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);" text="Назад" />
   </children>
</AnchorPane>
