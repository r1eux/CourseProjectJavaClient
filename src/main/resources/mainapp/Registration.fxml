<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="445.0" prefWidth="386.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Requests.Registration">
    <children>
        <!-- Заголовок "Регистрация" -->
        <Label layoutX="19.0" layoutY="14.0" text="Регистрация">
            <font>
                <Font size="30.0" />
            </font>
        </Label>

        <!-- Лейблы и текстовые поля -->
        <Label layoutX="36.0" layoutY="53.0" text="Логин:" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
        <TextField fx:id="textfieldLogin" layoutX="30.0" layoutY="70.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 5px;" />

        <Label layoutX="217.0" layoutY="53.0" text="Номер телефона:" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
        <TextField fx:id="textfieldPhone" layoutX="217.0" layoutY="70.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 5px;" />

        <Label layoutX="33.0" layoutY="107.0" text="Пароль:" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
        <PasswordField fx:id="passwordfieldPassword" layoutX="30.0" layoutY="124.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 5px;" />

        <Label layoutX="30.0" layoutY="159.0" text="Подтверждение пароля:" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
        <PasswordField fx:id="passwordfieldConfirmPassword" layoutX="30.0" layoutY="176.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 5px;" />

        <Label layoutX="219.0" layoutY="107.0" text="Пол:" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
        <RadioButton fx:id="cbMale" layoutX="216.0" layoutY="128.0" mnemonicParsing="false" text="M" style="-fx-font-size: 14px; -fx-text-fill: #000000;">
            <toggleGroup>
                <ToggleGroup fx:id="Sex" />
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="cbFemale" layoutX="265.0" layoutY="128.0" mnemonicParsing="false" text="Ж" toggleGroup="$Sex" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />

        <Label layoutX="30.0" layoutY="216.0" text="Имя:" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
        <TextField fx:id="textfieldName" layoutX="30.0" layoutY="234.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 5px;" />

        <Label layoutX="30.0" layoutY="274.0" text="Страна:" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
        <TextField fx:id="textfieldCountry" layoutX="30.0" layoutY="292.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 5px;" />

        <Label layoutX="30.0" layoutY="336.0" text="Город:" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
        <TextField fx:id="textfieldCity" layoutX="30.0" layoutY="354.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 5px;" />

        <Label layoutX="222.0" layoutY="159.0" text="Улица:" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
        <TextField fx:id="textfieldStreet" layoutX="217.0" layoutY="176.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 5px;" />

        <Label layoutX="219.0" layoutY="216.0" text="Дом:" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
        <TextField fx:id="textfieldHouseNumber" layoutX="217.0" layoutY="234.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 5px;" />

        <Label layoutX="215.0" layoutY="274.0" text="Почтовый индекс:" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
        <TextField fx:id="textfieldPostIndex" layoutX="217.0" layoutY="292.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 5px;" />

        <Label layoutX="213.0" layoutY="336.0" text="Электронная почта:" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
        <TextField fx:id="textfieldEmail" layoutX="216.0" layoutY="353.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 5px; -fx-padding: 5px;" />

        <!-- Кнопки -->
        <Button fx:id="buttonSignUp" layoutX="60.0" layoutY="396.0" mnemonicParsing="false" onAction="#Signup_Pressed" prefHeight="35.0" prefWidth="130.0" text="Регистрация" style="-fx-background-color: linear-gradient(#6422ff, #3b17b5); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);" />
        <Button fx:id="buttonBack" layoutX="267.0" layoutY="396.0" mnemonicParsing="false" onAction="#Back_Pressed" text="Назад" style="-fx-background-color: linear-gradient(#2196F3, #4a5cd3); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.3), 8, 0.5, 0, 2);" />

        <!-- Сообщение об ошибке -->
        <Label fx:id="labelMessage" alignment="CENTER" contentDisplay="CENTER" layoutX="221.0" layoutY="357.0" prefHeight="18.0" prefWidth="90.0" text="error" textFill="RED" visible="false" />
    </children>
</AnchorPane>
